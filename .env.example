# Supabase — pegue em Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Usado só no servidor (server actions / route handlers), nunca exposto ao cliente
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Service role do Supabase — só para o cron (Project Settings > API > service_role).
# NUNCA prefixe com NEXT_PUBLIC_, nunca exponha ao browser.
SUPABASE_SERVICE_ROLE_KEY=

# Segredo que só o Vercel Cron conhece, para autorizar a chamada do job diário.
# Gere um valor aleatório, ex: openssl rand -hex 32
CRON_SECRET=

# Preenchido na Fase 4, quando o Harmony Hub existir
HARMONY_HUB_URL=
HARMONY_HUB_SHARED_SECRET=